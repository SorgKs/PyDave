#!/usr/bin/env python3
# assemble_door.py — собирает дверь, обрезает и дополняет до сетки 16x16
# Запуск: python assemble_door.py
import os, struct, math

BASE = os.path.dirname(os.path.abspath(__file__))
TILES_DIR = os.path.join(BASE, 'assets', 'sprites', 'tiles')
OUT_DIR = os.path.join(BASE, 'assets', 'sheets')
os.makedirs(OUT_DIR, exist_ok=True)

TS = 16

def read_bmp(path):
    with open(path, 'rb') as f:
        data = f.read()
    offset = struct.unpack('<I', data[10:14])[0]
    w = struct.unpack('<I', data[18:22])[0]
    h = struct.unpack('<I', data[22:26])[0]
    px = [[(0,0,0,255)]*w for _ in range(h)]
    for y in range(h):
        row_data = data[offset + y * ((w*3+3)//4)*4 : offset + (y+1) * ((w*3+3)//4)*4]
        for x in range(w):
            b, g, r = row_data[x*3], row_data[x*3+1], row_data[x*3+2]
            if r == 255 and g == 0 and b == 255:
                px[h-1-y][x] = (0, 0, 0, 0)
            else:
                px[h-1-y][x] = (r, g, b, 255)
    return w, h, px

def write_bmp(path, px, w, h):
    rs = ((w*3+3)//4)*4; ps = rs*h
    hdr = b'BM' + struct.pack('<III', 14+40+ps, 0, 54)
    info = struct.pack('<IiiHHIIiiII', 40, w, h, 1, 24, 0, ps, 2835, 2835, 0, 0)
    pix = bytearray()
    for y in range(h-1, -1, -1):
        row = bytearray()
        for x in range(w):
            r, g, b, a = px[y][x]
            row += bytes([255, 0, 255]) if a < 128 else bytes([b, g, r])
        while len(row) % 4: row += b'\x00'
        pix += row
    open(path, 'wb').write(hdr + info + pix)

def find_tile(name_or_num):
    path = os.path.join(TILES_DIR, f'{name_or_num}.bmp')
    if os.path.exists(path):
        return path
    try:
        num = int(name_or_num)
        path = os.path.join(TILES_DIR, f'tile_{num:03d}.bmp')
        if os.path.exists(path):
            return path
    except ValueError:
        pass
    return None

# Матрица двери 2 (7 строк × 4 колонки)
DOOR2_MATRIX = [
    [49, 50, 51, 52],
    [61, 62, 63, 64],
    [75, 76, 77, 78],
    [85, 86, 87, 88],
    [104, 86, 87, 105],
    [119, 120, 121, 122],
    [135, 136, 136, 137],
]

# Настройки обрезки для двери 2
DOOR2_CROP = {'left': 1, 'top': 2, 'right': 0, 'bottom': 5}

def assemble_door(matrix, name='door', crop=None, pad_to_grid=True, pad_sides=None):
    rows = len(matrix)
    cols = len(matrix[0]) if rows > 0 else 0
    
    # Загружаем все тайлы
    tile_cache = {}
    for row in matrix:
        for tile_ref in row:
            if tile_ref not in tile_cache:
                path = find_tile(str(tile_ref))
                if not path:
                    print(f'! не найден тайл: {tile_ref}')
                    return None
                tile_cache[tile_ref] = read_bmp(path)[2]
    
    # Собираем полную сетку
    out_w = cols * TS
    out_h = rows * TS
    out_px = [[(255, 0, 255, 255)] * out_w for _ in range(out_h)]
    
    for row_idx, row in enumerate(matrix):
        for col_idx, tile_ref in enumerate(row):
            src = tile_cache[tile_ref]
            for y in range(TS):
                for x in range(TS):
                    out_px[row_idx * TS + y][col_idx * TS + x] = src[y][x]
    
    print(f'  собрано: {out_w}x{out_h}')
    
    # Обрезка
    if crop:
        left = crop.get('left', 0)
        top = crop.get('top', 0)
        right = crop.get('right', 0)
        bottom = crop.get('bottom', 0)
        
        out_px = [
            row[left : out_w - right] 
            for row in out_px[top : out_h - bottom]
        ]
        out_w = out_w - left - right
        out_h = out_h - top - bottom
        print(f'  обрезка: L:{left} T:{top} R:{right} B:{bottom} -> {out_w}x{out_h}')
    
    # Дополнение до сетки 16x16
    if pad_to_grid:
        # Целевые размеры (кратные 16)
        target_w = math.ceil(out_w / TS) * TS
        target_h = math.ceil(out_h / TS) * TS
        
        add_w = target_w - out_w
        add_h = target_h - out_h
        
        if add_w > 0 or add_h > 0:
            # Определяем, куда добавлять пиксели
            if pad_sides:
                top_pad = pad_sides.get('top', 0)
                bottom_pad = pad_sides.get('bottom', 0)
                left_pad = pad_sides.get('left', 0)
                right_pad = pad_sides.get('right', 0)
            else:
                # По умолчанию: равномерно, но снизу 0
                top_pad = add_h
                bottom_pad = 0
                left_pad = add_w // 2
                right_pad = add_w - left_pad
            
            # Создаём новый массив с прозрачным фоном
            new_px = [[(0, 0, 0, 0)] * target_w for _ in range(target_h)]
            
            # Копируем исходное изображение со смещением
            for y in range(out_h):
                for x in range(out_w):
                    new_px[y + top_pad][x + left_pad] = out_px[y][x]
            
            out_px = new_px
            out_w, out_h = target_w, target_h
            print(f'  дополнение: T:{top_pad} B:{bottom_pad} L:{left_pad} R:{right_pad} -> {out_w}x{out_h}')
    
    out_path = os.path.join(OUT_DIR, f'{name}.bmp')
    write_bmp(out_path, out_px, out_w, out_h)
    print(f'✓ готово: {out_path} ({out_w}x{out_h}) = {out_w//TS}x{out_h//TS} тайлов')
    return out_path

if __name__ == '__main__':
    print('Сборка двери 2...')
    assemble_door(
        DOOR2_MATRIX, 
        'door2', 
        crop=DOOR2_CROP,
        pad_to_grid=True,
        pad_sides={'top': 7, 'bottom': 0, 'left': 0, 'right': 1}
    )
